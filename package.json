{
  "name": "smartstay-api",
  "version": "1.0.0",
  "description": "SmartStay REST API",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback --all",
    "seed": "knex seed:run",
    "db:reset": "knex migrate:rollback --all && knex migrate:latest && knex seed:run",
    "test": "vitest run",
    "test:watch": "vitest",
    "import:mapping": "node scripts/import-mapping.js",
    "import:staff": "node scripts/import-staff.js",
    "import:energy": "node scripts/import-energy.js",
    "device:event": "node scripts/device-event.js",
    "docs:openapi": "node scripts/export-openapi.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cron-parser": "^5.10.2",
    "csv-parse": "^7.0.3",
    "csv-stringify": "^6.9.0",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.3.0",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.0",
    "qrcode": "^1.5.4",
    "socket.io": "^4.8.4",
    "swagger-ui-express": "^5.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
