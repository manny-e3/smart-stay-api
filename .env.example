NODE_ENV=development
PORT=5000
# Comma-separated list of dashboard origins allowed to call the API
CORS_ORIGIN=http://localhost:5173
TRUST_PROXY=false

# MySQL (XAMPP defaults)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smartstay
DB_NAME_TEST=smartstay_test

# Auth
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-another-long-random-string
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
# Guest app tokens and encrypted digital key credentials (required in production)
JWT_GUEST_SECRET=replace-with-a-third-long-random-string
DATA_ENCRYPTION_SECRET=replace-with-a-fourth-long-random-string
GUEST_TOKEN_DAYS=30

# First admin account created by "npm run seed"
ADMIN_EMAIL=admin@smartstay.local
ADMIN_PASSWORD=ChangeMe123!
ADMIN_NAME=System Admin

# Email (leave SMTP_HOST empty to log emails to the console instead)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=SmartStay <no-reply@smartstay.local>

# Browser push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@smartstay.local

# Guest app push via Firebase (path to service account JSON; empty = disabled)
FIREBASE_SERVICE_ACCOUNT=

# Background jobs
JOBS_ENABLED=true
DEVICE_POLL_SECONDS=5
ESCALATION_CHECK_SECONDS=30
ADAPTER_HEALTH_SECONDS=60
RULES_TICK_SECONDS=60
ENERGY_IMPORT_MINUTES=60
STAYS_JOB_MINUTES=15
PMS_RECONCILE_MINUTES=10
